// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Image {
  id        String   @id @default(uuid())
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("images")
}

model Product {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  price            Decimal
  shortDescription String?
  description      String?
  position         Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categories Category[]
  images     Image[]
  fields     ProductField[]
  orderItems OrderItem[]

  @@map("products")
}

// Полета за персонализация, които клиентът попълва при поръчка.
enum ProductFieldType {
  PHOTO
  TEXT
  TEXTAREA
  DATE
  CHOICE
}

model ProductField {
  id          String           @id @default(uuid())
  type        ProductFieldType
  label       String
  hint        String?
  placeholder String?
  required    Boolean          @default(true)
  maxLength   Int?
  maxFiles    Int?
  options     String[]
  position    Int              @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_fields")
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_PROGRESS
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderChannel {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  WEBSITE
  PHONE
  OTHER
}

enum Courier {
  ECONT
  SPEEDY
  PICKUP
}

enum ContactMethod {
  CALL
  VIBER
  MESSENGER
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BANK_TRANSFER
  CASH
}

model Order {
  id              String        @id @default(uuid())
  number          Int           @unique @default(autoincrement())
  status          OrderStatus   @default(NEW)
  customerName    String
  customerPhone   String
  customerEmail   String?
  contactMethod   ContactMethod?
  channel         OrderChannel  @default(INSTAGRAM)
  courier         Courier       @default(ECONT)
  deliveryAddress String?
  trackingNumber  String?
  paymentMethod   PaymentMethod @default(CASH_ON_DELIVERY)
  isPaid          Boolean       @default(false)
  deadline        DateTime?     @db.Date
  notes           String?
  total           Decimal       @default(0) @db.Decimal(10, 2)
  // Попълват се само при поръчка от сайта.
  substitutionConsent Boolean   @default(false)
  privacyAcceptedAt   DateTime?
  attribution         Json?
  photosDeletedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items   OrderItem[]
  history OrderHistory[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  name      String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)
  // Копие на попълнената персонализация: [{ fieldId, label, type, value }]
  personalization Json?

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model OrderHistory {
  id        String       @id @default(uuid())
  message   String
  status    OrderStatus?
  createdAt DateTime     @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_history")
}
