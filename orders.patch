@@ -0,0 +1,329 @@
+.order-details-title {
+  margin-top: 8px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  flex-wrap: wrap;
+}
+
+.order-details-heading {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  flex-wrap: wrap;
+}
+
+/* Път на поръчката */
+.order-progress {
+  padding: 24px 26px;
+  display: flex;
+  flex-direction: column;
+  gap: 22px;
+}
+
+.order-steps {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  grid-template-columns: repeat(6, minmax(0, 1fr));
+}
+
+.order-step {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 8px;
+  font-size: 0.85rem;
+  color: #7a5c52;
+  text-align: center;
+}
+
+.order-step::before {
+  content: "";
+  position: absolute;
+  top: 15px;
+  left: -50%;
+  right: 50%;
+  height: 2px;
+  background: #ead9cd;
+}
+
+.order-step:first-child::before {
+  display: none;
+}
+
+.order-step.done::before,
+.order-step.current::before {
+  background: #8f6a5e;
+}
+
+.order-step-dot {
+  position: relative;
+  z-index: 1;
+  width: 32px;
+  height: 32px;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-weight: 600;
+  background: #fff;
+  border: 2px solid #ead9cd;
+  color: #b9917f;
+}
+
+.order-step.done .order-step-dot {
+  background: #8f6a5e;
+  border-color: #8f6a5e;
+  color: #fff;
+}
+
+.order-step.current {
+  color: #5c463e;
+  font-weight: 600;
+}
+
+.order-step.current .order-step-dot {
+  border-color: #8f6a5e;
+  color: #8f6a5e;
+  box-shadow: 0 0 0 4px #8f6a5e22;
+}
+
+.order-steps--cancelled .order-step {
+  opacity: 0.4;
+}
+
+.order-progress-actions {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 20px;
+  flex-wrap: wrap;
+  padding-top: 18px;
+  border-top: 1px solid #f0e4db;
+}
+
+.order-next {
+  display: flex;
+  align-items: flex-end;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+
+.order-field-inline {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  font-size: 0.875rem;
+}
+
+.order-field-inline .orders-input {
+  width: 240px;
+}
+
+.order-final {
+  margin: 0;
+}
+
+.order-secondary-actions {
+  display: flex;
+  gap: 18px;
+  flex-wrap: wrap;
+}
+
+/* Двете колони отдолу */
+.order-details-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 380px;
+  gap: 20px;
+  align-items: start;
+}
+
+.order-details-column {
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+  min-width: 0;
+}
+
+.order-box {
+  padding: 22px 26px;
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+}
+
+.order-box h3 {
+  margin: 0;
+  font-size: 1.1rem;
+  font-weight: 400;
+  color: #8f6a5e;
+}
+
+.order-box p {
+  margin: 0;
+  font-size: 0.9rem;
+}
+
+.order-box .orders-text-btn {
+  align-self: flex-start;
+}
+
+.order-box-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.order-line {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 60px 90px 90px;
+  gap: 12px;
+  padding: 10px 0;
+  border-bottom: 1px solid #f4ebe4;
+  font-size: 0.9rem;
+  font-variant-numeric: tabular-nums;
+}
+
+.order-line > span:not(:first-child) {
+  text-align: right;
+}
+
+.order-line--head {
+  padding-top: 0;
+  font-size: 0.8rem;
+  color: #7a5c52;
+}
+
+.order-line-link {
+  color: #5c463e;
+  text-decoration: underline;
+  text-decoration-color: #d8c7ba;
+  text-underline-offset: 3px;
+}
+
+.order-total {
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+  font-variant-numeric: tabular-nums;
+}
+
+.order-total span {
+  color: #7a5c52;
+}
+
+.order-total strong {
+  font-size: 1.4rem;
+  color: #8f6a5e;
+}
+
+.order-notes {
+  line-height: 1.6;
+  white-space: pre-line;
+}
+
+.order-kv {
+  display: grid;
+  grid-template-columns: 110px minmax(0, 1fr);
+  gap: 8px 12px;
+  margin: 0;
+  font-size: 0.9rem;
+}
+
+.order-kv dt {
+  color: #7a5c52;
+}
+
+.order-kv dd {
+  margin: 0;
+  overflow-wrap: anywhere;
+}
+
+.order-badge {
+  padding: 4px 10px;
+  border-radius: 999px;
+  font-size: 0.8rem;
+}
+
+.order-badge--paid {
+  background: #e3f1e6;
+  color: #2e6b40;
+}
+
+.order-badge--unpaid {
+  background: #fcefd9;
+  color: #7d5210;
+}
+
+/* История */
+.order-history {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  font-size: 0.9rem;
+}
+
+.order-history li {
+  position: relative;
+  display: grid;
+  grid-template-columns: 14px minmax(0, 1fr);
+  gap: 12px;
+  padding-bottom: 14px;
+}
+
+.order-history li:last-child {
+  padding-bottom: 0;
+}
+
+.order-history li::before {
+  content: "";
+  position: absolute;
+  left: 6px;
+  top: 14px;
+  bottom: -2px;
+  width: 2px;
+  background: #f0e4db;
+}
+
+.order-history li:last-child::before {
+  display: none;
+}
+
+.order-history-dot {
+  width: 10px;
+  height: 10px;
+  margin-top: 4px;
+  border-radius: 50%;
+  background: #8f6a5e;
+  box-shadow: 0 0 0 3px #fff;
+}
+
+.order-delete {
+  align-self: flex-start;
+}
+
+@media (max-width: 900px) {
+  .order-details-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .order-steps {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    row-gap: 18px;
+  }
+
+  .order-step:nth-child(4)::before {
+    display: none;
+  }
+
+  .order-field-inline .orders-input {
+    width: 100%;
+  }
+}
diff --git a/client/src/components/admin/orders/order-details/OrderDetails.jsx b/client/src/components/admin/orders/order-details/OrderDetails.jsx
new file mode 100644
index 0000000..9a74a63
--- /dev/null
+++ b/client/src/components/admin/orders/order-details/OrderDetails.jsx
@@ -0,0 +1,371 @@
+import { useEffect, useState } from 'react';
+import { Link, useNavigate, useParams } from 'react-router';
+import {
+    getOrderById,
+    updateOrderStatus,
+    updateOrderPaid,
+    deleteOrder,
+} from '../../../../services/orders';
+import {
+    STATUS_FLOW,
+    STATUS_LABELS,
+    NEXT_STEP_LABELS,
+    CHANNEL_LABELS,
+    COURIER_LABELS,
+    PAYMENT_LABELS,
+    statusClass,
+    formatOrderNumber,
+    formatMoney,
+    formatDate,
+    formatDateTime,
+    deadlineInfo,
+} from '../../../../utils/orders';
+import '../orders.css';
+import './OrderDetails.css';
+
+function CheckIcon() {
+    return (
+        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
+            strokeWidth="3" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+            <path d="M5 12l5 5 9-10" />
+        </svg>
+    );
+}
+
+export default function OrderDetails() {
+    const { id } = useParams();
+    const navigate = useNavigate();
+
+    const [order, setOrder] = useState(null);
+    const [isLoading, setIsLoading] = useState(true);
+    const [isSaving, setIsSaving] = useState(false);
+    const [error, setError] = useState('');
+    const [trackingDraft, setTrackingDraft] = useState('');
+
+    useEffect(() => {
+        async function loadOrder() {
+            try {
+                const data = await getOrderById(id);
+                setOrder(data);
+                setTrackingDraft(data.trackingNumber ?? '');
+            } catch (err) {
+                setError(err.message);
+            } finally {
+                setIsLoading(false);
+            }
+        }
+
+        loadOrder();
+    }, [id]);
+
+    // Общо за всички действия: изпраща заявката и обновява поръчката.
+    const run = async (action) => {
+        setIsSaving(true);
+        setError('');
+
+        try {
+            setOrder(await action());
+        } catch (err) {
+            setError(err.message);
+        } finally {
+            setIsSaving(false);
+        }
+    };
+
+    if (isLoading) {
+        return <div className="orders-page"><p>Зареждане...</p></div>;
+    }
+
+    if (!order) {
+        return (
+            <div className="orders-page">
+                <Link to="/admin/orders" className="orders-back">← Всички поръчки</Link>
+                <p className="orders-message orders-message--error">
+                    {error || 'Поръчката не е намерена.'}
+                </p>
+            </div>
+        );
+    }
+
+    const isCancelled = order.status === 'CANCELLED';
+    const stepIndex = STATUS_FLOW.indexOf(order.status);
+    const nextStatus = !isCancelled ? STATUS_FLOW[stepIndex + 1] : undefined;
+    const previousStatus = !isCancelled && stepIndex > 0 ? STATUS_FLOW[stepIndex - 1] : undefined;
+    const needsTracking = nextStatus === 'SHIPPED' && order.courier !== 'PICKUP';
+
+    // При възстановяване връщаме последния статус преди отказа.
+    const statusBeforeCancel =
+        order.history.find(entry => entry.status && entry.status !== 'CANCELLED')?.status ?? 'NEW';
+
+    const due = deadlineInfo(order);
+
+    const handleNext = () => {
+        run(() => updateOrderStatus(order.id, nextStatus, needsTracking ? trackingDraft.trim() : undefined));
+    };
+
+    const handleCancel = () => {
+        if (window.confirm('Сигурни ли сте, че искате да откажете поръчката?')) {
+            run(() => updateOrderStatus(order.id, 'CANCELLED'));
+        }
+    };
+
+    const handleDelete = async () => {
+        if (!window.confirm('Поръчката ще бъде изтрита завинаги. Продължаване?')) {
+            return;
+        }
+
+        try {
+            await deleteOrder(order.id);
+            navigate('/admin/orders');
+        } catch (err) {
+            setError(err.message);
+        }
+    };
+
+    return (
+        <div className="orders-page">
+            <div>
+                <Link to="/admin/orders" className="orders-back">← Всички поръчки</Link>
+
+                <div className="order-details-title">
+                    <div className="order-details-heading">
+                        <h2>Поръчка {formatOrderNumber(order.number)}</h2>
+                        <span className={statusClass(order.status)}>
+                            {STATUS_LABELS[order.status]}
+                        </span>
+                    </div>
+
+                    <div className="order-details-heading">
+                        <span className="orders-muted">
+                            Създадена {formatDateTime(order.createdAt)}
+                        </span>
+                        <Link to={`/admin/orders/edit/${order.id}`} className="admin-nav-btn">
+                            Редактирай
+                        </Link>
+                    </div>
+                </div>
+            </div>
+
+            {/* Път на поръчката и следваща стъпка */}
+            <section className="orders-card order-progress">
+                <ol className={`order-steps ${isCancelled ? 'order-steps--cancelled' : ''}`}>
+                    {STATUS_FLOW.map((status, index) => {
+                        const isDone = !isCancelled && index < stepIndex;
+                        const isCurrent = !isCancelled && index === stepIndex;
+
+                        return (
+                            <li
+                                key={status}
+                                className={`order-step ${isDone ? 'done' : ''} ${isCurrent ? 'current' : ''}`}
+                                aria-current={isCurrent ? 'step' : undefined}
+                            >
+                                <span className="order-step-dot">
+                                    {isDone ? <CheckIcon /> : index + 1}
+                                </span>
+                                <span>{STATUS_LABELS[status]}</span>
+                            </li>
+                        );
+                    })}
+                </ol>
+
+                <div className="order-progress-actions">
+                    {nextStatus && (
+                        <div className="order-next">
+                            {needsTracking && (
+                                <div className="order-field-inline">
+                                    <label htmlFor="trackingNumber">Номер на товарителница</label>
+                                    <input
+                                        id="trackingNumber"
+                                        className="orders-input"
+                                        type="text"
+                                        maxLength={50}
+                                        placeholder="напр. 1051 6024 8833"
+                                        value={trackingDraft}
+                                        onChange={event => setTrackingDraft(event.target.value)}
+                                    />
+                                </div>
+                            )}
+
+                            <button
+                                type="button"
+                                className="orders-btn"
+                                disabled={isSaving || (needsTracking && !trackingDraft.trim())}
+                                onClick={handleNext}
+                            >
+                                {NEXT_STEP_LABELS[nextStatus]}
+                            </button>
+                        </div>
+                    )}
+
+                    {!nextStatus && (
+                        <p className="order-final">
+                            {isCancelled ? 'Поръчката е отказана.' : 'Поръчката е доставена.'}
+                        </p>
+                    )}
+
+                    <div className="order-secondary-actions">
+                        {previousStatus && (
+                            <button
+                                type="button"
+                                className="orders-text-btn"
+                                disabled={isSaving}
+                                onClick={() => run(() => updateOrderStatus(order.id, previousStatus))}
+                            >
+                                ← Върни на „{STATUS_LABELS[previousStatus]}“
+                            </button>
+                        )}
+
+                        {!isCancelled && order.status !== 'DELIVERED' && (
+                            <button
+                                type="button"
+                                className="orders-text-btn orders-text-btn--danger"
+                                disabled={isSaving}
+                                onClick={handleCancel}
+                            >
+                                Откажи поръчката
+                            </button>
+                        )}
+
+                        {isCancelled && (
+                            <button
+                                type="button"
+                                className="orders-text-btn"
+                                disabled={isSaving}
+                                onClick={() => run(() => updateOrderStatus(order.id, statusBeforeCancel))}
+                            >
+                                Възстанови поръчката
+                            </button>
+                        )}
+                    </div>
+                </div>
+            </section>
+
+            {error && <p className="orders-message orders-message--error">{error}</p>}
+
+            <div className="order-details-grid">
+                <div className="order-details-column">
+                    <section className="orders-card order-box">
+                        <h3>Продукти</h3>
+
+                        <div className="order-lines">
+                            <div className="order-line order-line--head" aria-hidden="true">
+                                <span>Продукт</span>
+                                <span>Брой</span>
+                                <span>Ед. цена</span>
+                                <span>Сума</span>
+                            </div>
+
+                            {order.items.map(item => (
+                                <div className="order-line" key={item.id}>
+                                    <span>
+                                        {item.product?.slug ? (
+                                            <Link to={`/products/${item.product.slug}`} className="order-line-link">
+                                                {item.name}
+                                            </Link>
+                                        ) : (
+                                            item.name
+                                        )}
+                                    </span>
+                                    <span>{item.quantity}</span>
+                                    <span>{formatMoney(item.unitPrice)}</span>
+                                    <span>{formatMoney(item.quantity * Number(item.unitPrice))}</span>
+                                </div>
+                            ))}
+                        </div>
+
+                        <div className="order-total">
+                            <span>Общо</span>
+                            <strong>{formatMoney(order.total)}</strong>
+                        </div>
+                    </section>
+
+                    {order.notes && (
+                        <section className="orders-card order-box">
+                            <h3>Бележка</h3>
+                            <p className="order-notes">{order.notes}</p>
+                        </section>
+                    )}
+
+                    <section className="orders-card order-box">
+                        <h3>Клиент</h3>
+                        <dl className="order-kv">
+                            <dt>Име</dt>
+                            <dd>{order.customerName}</dd>
+                            <dt>Телефон</dt>
+                            <dd>{order.customerPhone}</dd>
+                            <dt>Откъде</dt>
+                            <dd>{CHANNEL_LABELS[order.channel]}</dd>
+                        </dl>
+                    </section>
+                </div>
+
+                <div className="order-details-column">
+                    <section className="orders-card order-box">
+                        <h3>Срок</h3>
+                        <p>
+                            <span className={due.className}>{due.text}</span>
+                            {due.date && <span className="orders-muted"> · {formatDate(order.deadline)}</span>}
+                        </p>
+                    </section>
+
+                    <section className="orders-card order-box">
+                        <h3>Доставка</h3>
+                        <dl className="order-kv">
+                            <dt>Куриер</dt>
+                            <dd>{COURIER_LABELS[order.courier]}</dd>
+                            {order.courier !== 'PICKUP' && (
+                                <>
+                                    <dt>Адрес</dt>
+                                    <dd>{order.deliveryAddress || '—'}</dd>
+                                    <dt>Товарителница</dt>
+                                    <dd>{order.trackingNumber ? `№ ${order.trackingNumber}` : 'Още не е изпратена'}</dd>
+                                </>
+                            )}
+                        </dl>
+                    </section>
+
+                    <section className="orders-card order-box">
+                        <div className="order-box-head">
+                            <h3>Плащане</h3>
+                            <span className={order.isPaid ? 'order-badge order-badge--paid' : 'order-badge order-badge--unpaid'}>
+                                {order.isPaid ? 'Платено' : 'Чака плащане'}
+                            </span>
+                        </div>
+                        <p>{PAYMENT_LABELS[order.paymentMethod]} · {formatMoney(order.total)}</p>
+                        <button
+                            type="button"
+                            className="orders-text-btn"
+                            disabled={isSaving}
+                            onClick={() => run(() => updateOrderPaid(order.id, !order.isPaid))}
+                        >
+                            {order.isPaid ? 'Отбележи като неплатена' : 'Отбележи като платена'}
+                        </button>
+                    </section>
+
+                    <section className="orders-card order-box">
+                        <h3>История</h3>
+                        <ul className="order-history">
+                            {order.history.map(entry => (
+                                <li key={entry.id}>
+                                    <span className="order-history-dot" />
+                                    <div>
+                                        <div>{entry.message}</div>
+                                        <div className="orders-muted">{formatDateTime(entry.createdAt)}</div>
+                                    </div>
+                                </li>
+                            ))}
+                        </ul>
+                    </section>
+
+                    <button
+                        type="button"
+                        className="orders-text-btn orders-text-btn--danger order-delete"
+                        onClick={handleDelete}
+                    >
+                        Изтрий поръчката
+                    </button>
+                </div>
+            </div>
+        </div>
+    );
+}
