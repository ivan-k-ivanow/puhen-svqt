+++ b/server/src/schemas/order-schema.js
@@ -0,0 +1,77 @@
+import * as zod from 'zod';
+
+export const ORDER_STATUSES = [
+    'NEW',
+    'CONFIRMED',
+    'IN_PROGRESS',
+    'READY',
+    'SHIPPED',
+    'DELIVERED',
+    'CANCELLED',
+];
+
+export const ORDER_CHANNELS = ['INSTAGRAM', 'FACEBOOK', 'TIKTOK', 'WEBSITE', 'PHONE', 'OTHER'];
+export const COURIERS = ['ECONT', 'SPEEDY', 'PICKUP'];
+export const PAYMENT_METHODS = ['CASH_ON_DELIVERY', 'BANK_TRANSFER', 'CASH'];
+
+// Празен текст от формата се записва като null.
+const optionalText = (max) =>
+    zod
+        .string()
+        .trim()
+        .max(max)
+        .optional()
+        .nullable()
+        .transform(value => (value ? value : null));
+
+const orderItemSchema = zod.object({
+    productId: zod.string().uuid().optional().nullable(),
+    name: zod.string().trim().min(1, 'Изберете продукт').max(150),
+    quantity: zod.coerce.number().int().min(1, 'Броят трябва да е поне 1'),
+    unitPrice: zod.coerce.number().min(0, 'Цената не може да е отрицателна'),
+});
+
+const orderFields = {
+    customerName: zod
+        .string()
+        .trim()
+        .min(2, 'Името трябва да съдържа поне 2 символа')
+        .max(100),
+    customerPhone: zod
+        .string()
+        .trim()
+        .min(6, 'Невалиден телефон')
+        .max(30),
+    channel: zod.enum(ORDER_CHANNELS),
+    courier: zod.enum(COURIERS),
+    deliveryAddress: optionalText(300),
+    paymentMethod: zod.enum(PAYMENT_METHODS),
+    deadline: zod
+        .string()
+        .regex(/^\d{4}-\d{2}-\d{2}$/, 'Невалидна дата')
+        .optional()
+        .nullable()
+        .or(zod.literal(''))
+        .transform(value => (value ? value : null)),
+    notes: optionalText(2000),
+    items: zod.array(orderItemSchema).min(1, 'Добавете поне един продукт'),
+};
+
+export const createOrderSchema = zod.object(orderFields);
+
+// При редакция се променят и полетата, които ги няма при създаване.
+export const updateOrderSchema = zod.object({
+    ...orderFields,
+    status: zod.enum(ORDER_STATUSES),
+    trackingNumber: optionalText(50),
+    isPaid: zod.boolean(),
+});
+
+export const updateOrderStatusSchema = zod.object({
+    status: zod.enum(ORDER_STATUSES),
+    trackingNumber: optionalText(50),
+});
+
+export const updateOrderPaidSchema = zod.object({
+    isPaid: zod.boolean(),
+});
diff --git a/server/src/services/order-service.js b/server/src/services/order-service.js
new file mode 100644
index 0000000..414cd62
--- /dev/null
+++ b/server/src/services/order-service.js
@@ -0,0 +1,150 @@
+import orderRepository from '../repositories/order-repository.js';
+
+const STATUS_LABELS = {
+    NEW: 'Нова',
+    CONFIRMED: 'Потвърдена',
+    IN_PROGRESS: 'В изработка',
+    READY: 'Готова',
+    SHIPPED: 'Изпратена',
+    DELIVERED: 'Доставена',
+    CANCELLED: 'Отказана',
+};
+
+function calculateTotal(items) {
+    const total = items.reduce(
+        (sum, item) => sum + item.quantity * item.unitPrice,
+        0
+    );
+
+    return Math.round(total * 100) / 100;
+}
+
+function toDate(value) {
+    return value ? new Date(`${value}T00:00:00.000Z`) : null;
+}
+
+function prepareItems(items) {
+    return items.map(item => ({
+        name: item.name,
+        quantity: item.quantity,
+        unitPrice: item.unitPrice,
+        productId: item.productId || null,
+    }));
+}
+
+function statusEntry(status, trackingNumber) {
+    let message = `Статус: ${STATUS_LABELS[status]}`;
+
+    if (status === 'SHIPPED' && trackingNumber) {
+        message += ` · № ${trackingNumber}`;
+    }
+
+    return { message, status };
+}
+
+async function getAllOrders() {
+    return await orderRepository.getAllOrders();
+}
+
+async function getOrderById(id) {
+    return await orderRepository.getOrderById(id);
+}
+
+async function createOrder(data) {
+    const items = prepareItems(data.items);
+
+    return await orderRepository.createOrder(
+        {
+            ...data,
+            deadline: toDate(data.deadline),
+            items,
+            total: calculateTotal(items),
+        },
+        'Поръчката е създадена'
+    );
+}
+
+async function updateOrder(id, data) {
+    const current = await orderRepository.getOrderById(id);
+
+    if (!current) {
+        return null;
+    }
+
+    const items = prepareItems(data.items);
+    const history = [{ message: 'Поръчката е редактирана' }];
+
+    if (data.status !== current.status) {
+        history.push(statusEntry(data.status, data.trackingNumber));
+    }
+
+    if (data.isPaid !== current.isPaid) {
+        history.push({
+            message: data.isPaid ? 'Плащането е получено' : 'Плащането е отменено',
+        });
+    }
+
+    return await orderRepository.updateOrder(
+        id,
+        {
+            ...data,
+            deadline: toDate(data.deadline),
+            items,
+            total: calculateTotal(items),
+        },
+        history
+    );
+}
+
+async function updateOrderStatus(id, { status, trackingNumber }) {
+    const current = await orderRepository.getOrderById(id);
+
+    if (!current) {
+        return null;
+    }
+
+    if (current.status === status) {
+        return current;
+    }
+
+    const data = { status };
+
+    // Товарителницата се пази, ако не е подадена нова.
+    if (trackingNumber) {
+        data.trackingNumber = trackingNumber;
+    }
+
+    return await orderRepository.updateOrder(id, data, [
+        statusEntry(status, trackingNumber || current.trackingNumber),
+    ]);
+}
+
+async function updateOrderPaid(id, isPaid) {
+    const current = await orderRepository.getOrderById(id);
+
+    if (!current) {
+        return null;
+    }
+
+    if (current.isPaid === isPaid) {
+        return current;
+    }
+
+    return await orderRepository.updateOrder(id, { isPaid }, [
+        { message: isPaid ? 'Плащането е получено' : 'Плащането е отменено' },
+    ]);
+}
+
+async function deleteOrder(id) {
+    return await orderRepository.deleteOrder(id);
+}
+
+export default {
+    getAllOrders,
+    getOrderById,
+    createOrder,
+    updateOrder,
+    updateOrderStatus,
+    updateOrderPaid,
+    deleteOrder,
+};
