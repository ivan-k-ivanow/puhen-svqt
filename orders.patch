diff --git a/client/src/components/admin/orders/order-form/OrderForm.jsx b/client/src/components/admin/orders/order-form/OrderForm.jsx
new file mode 100644
index 0000000..7100a52
--- /dev/null
+++ b/client/src/components/admin/orders/order-form/OrderForm.jsx
@@ -0,0 +1,456 @@
+import { useEffect, useState } from 'react';
+import { Link, useNavigate } from 'react-router';
+import { getProducts } from '../../../../services/products';
+import { createOrder, updateOrder } from '../../../../services/orders';
+import {
+    STATUSES,
+    STATUS_LABELS,
+    CHANNEL_LABELS,
+    COURIER_LABELS,
+    PAYMENT_LABELS,
+    formatOrderNumber,
+    formatMoney,
+    toDateInput,
+} from '../../../../utils/orders';
+import '../orders.css';
+import './OrderForm.css';
+
+const CUSTOM_PRODUCT = 'custom';
+
+let nextKey = 1;
+
+function emptyItem() {
+    return { key: nextKey++, productId: '', isCustom: false, name: '', quantity: 1, unitPrice: '' };
+}
+
+function itemFromOrder(item) {
+    return {
+        key: nextKey++,
+        productId: item.productId || '',
+        isCustom: !item.productId,
+        name: item.name,
+        quantity: item.quantity,
+        unitPrice: String(Number(item.unitPrice)),
+    };
+}
+
+function toNumber(value) {
+    const number = parseFloat(String(value).replace(',', '.'));
+    return Number.isFinite(number) ? number : 0;
+}
+
+function ChoicePills({ label, options, value, onChange }) {
+    return (
+        <div className="orders-pills" role="group" aria-label={label}>
+            {Object.entries(options).map(([optionValue, optionLabel]) => (
+                <button
+                    type="button"
+                    key={optionValue}
+                    className={`orders-pill ${value === optionValue ? 'active' : ''}`}
+                    aria-pressed={value === optionValue}
+                    onClick={() => onChange(optionValue)}
+                >
+                    {optionLabel}
+                </button>
+            ))}
+        </div>
+    );
+}
+
+// Без `order` е форма за нова поръчка, с `order` – за редакция.
+export default function OrderForm({ order }) {
+    const navigate = useNavigate();
+    const isEdit = Boolean(order);
+
+    const [products, setProducts] = useState([]);
+    const [form, setForm] = useState(() => ({
+        customerName: order?.customerName ?? '',
+        customerPhone: order?.customerPhone ?? '',
+        channel: order?.channel ?? 'INSTAGRAM',
+        courier: order?.courier ?? 'ECONT',
+        deliveryAddress: order?.deliveryAddress ?? '',
+        paymentMethod: order?.paymentMethod ?? 'CASH_ON_DELIVERY',
+        deadline: toDateInput(order?.deadline),
+        notes: order?.notes ?? '',
+        status: order?.status ?? 'NEW',
+        trackingNumber: order?.trackingNumber ?? '',
+        isPaid: order?.isPaid ?? false,
+    }));
+    const [items, setItems] = useState(() =>
+        order?.items?.length ? order.items.map(itemFromOrder) : [emptyItem()]
+    );
+    const [error, setError] = useState('');
+    const [isSaving, setIsSaving] = useState(false);
+
+    useEffect(() => {
+        getProducts()
+            .then(setProducts)
+            .catch(err => setError(err.message));
+    }, []);
+
+    const setField = (field, value) => {
+        setForm(current => ({ ...current, [field]: value }));
+    };
+
+    const setItem = (key, patch) => {
+        setItems(current =>
+            current.map(item => (item.key === key ? { ...item, ...patch } : item))
+        );
+    };
+
+    const handleProductChange = (item, value) => {
+        if (value === CUSTOM_PRODUCT) {
+            setItem(item.key, { productId: '', isCustom: true, name: '' });
+            return;
+        }
+
+        const product = products.find(p => p.id === value);
+
+        setItem(item.key, {
+            productId: value,
+            isCustom: false,
+            name: product?.name ?? '',
+            // Цената се попълва от продукта, но може да се промени.
+            unitPrice: product ? String(Number(product.price)) : item.unitPrice,
+        });
+    };
+
+    // Продукт от стара поръчка, който вече не е в каталога.
+    const missingProducts = items.filter(
+        item => item.productId && !products.some(product => product.id === item.productId)
+    );
+
+    const total = items.reduce(
+        (sum, item) => sum + toNumber(item.quantity) * toNumber(item.unitPrice),
+        0
+    );
+
+    const handleSubmit = async (event) => {
+        event.preventDefault();
+        setError('');
+
+        const payload = {
+            ...form,
+            deliveryAddress: form.courier === 'PICKUP' ? '' : form.deliveryAddress,
+            items: items
+                .filter(item => item.name.trim())
+                .map(item => ({
+                    productId: item.productId || null,
+                    name: item.name.trim(),
+                    quantity: toNumber(item.quantity),
+                    unitPrice: toNumber(item.unitPrice),
+                })),
+        };
+
+        if (!isEdit) {
+            delete payload.status;
+            delete payload.trackingNumber;
+            delete payload.isPaid;
+        }
+
+        if (payload.items.length === 0) {
+            setError('Добавете поне един продукт.');
+            return;
+        }
+
+        setIsSaving(true);
+
+        try {
+            const saved = isEdit
+                ? await updateOrder(order.id, payload)
+                : await createOrder(payload);
+
+            navigate(`/admin/orders/${saved.id}`);
+        } catch (err) {
+            setError(err.message);
+            setIsSaving(false);
+        }
+    };
+
+    const backLink = isEdit ? `/admin/orders/${order.id}` : '/admin/orders';
+
+    return (
+        <div className="orders-page order-form-page">
+            <div>
+                <Link to={backLink} className="orders-back">
+                    ← {isEdit ? 'Обратно към поръчката' : 'Всички поръчки'}
+                </Link>
+                <h2>
+                    {isEdit ? `Редакция на ${formatOrderNumber(order.number)}` : 'Нова поръчка'}
+                </h2>
+            </div>
+
+            <form className="orders-card order-form" onSubmit={handleSubmit}>
+                <section className="order-form-section">
+                    <h3>Клиент</h3>
+
+                    <div className="order-form-grid order-form-grid--2">
+                        <div className="order-field">
+                            <label htmlFor="customerName">
+                                Име <span className="order-required">*</span>
+                            </label>
+                            <input
+                                id="customerName"
+                                className="orders-input"
+                                type="text"
+                                required
+                                maxLength={100}
+                                placeholder="Име и фамилия"
+                                value={form.customerName}
+                                onChange={event => setField('customerName', event.target.value)}
+                            />
+                        </div>
+
+                        <div className="order-field">
+                            <label htmlFor="customerPhone">
+                                Телефон <span className="order-required">*</span>
+                            </label>
+                            <input
+                                id="customerPhone"
+                                className="orders-input"
+                                type="tel"
+                                required
+                                maxLength={30}
+                                placeholder="08X XXX XXXX"
+                                value={form.customerPhone}
+                                onChange={event => setField('customerPhone', event.target.value)}
+                            />
+                        </div>
+                    </div>
+
+                    <ChoicePills
+                        label="Откъде дойде поръчката"
+                        options={CHANNEL_LABELS}
+                        value={form.channel}
+                        onChange={value => setField('channel', value)}
+                    />
+                </section>
+
+                <section className="order-form-section">
+                    <h3>Продукти</h3>
+
+                    <div className="order-item order-item--head" aria-hidden="true">
+                        <span>Продукт</span>
+                        <span>Брой</span>
+                        <span>Цена €</span>
+                        <span />
+                    </div>
+
+                    {items.map(item => (
+                        <div className="order-item-block" key={item.key}>
+                            <div className="order-item">
+                                <label htmlFor={`product-${item.key}`} className="visually-hidden">
+                                    Продукт
+                                </label>
+                                <select
+                                    id={`product-${item.key}`}
+                                    className="orders-input"
+                                    value={item.isCustom ? CUSTOM_PRODUCT : item.productId}
+                                    onChange={event => handleProductChange(item, event.target.value)}
+                                >
+                                    <option value="">Избери продукт</option>
+                                    {products.map(product => (
+                                        <option key={product.id} value={product.id}>
+                                            {product.name}
+                                        </option>
+                                    ))}
+                                    {missingProducts.map(missing => (
+                                        <option key={missing.productId} value={missing.productId}>
+                                            {missing.name}
+                                        </option>
+                                    ))}
+                                    <option value={CUSTOM_PRODUCT}>Друго (по поръчка)</option>
+                                </select>
+
+                                <label htmlFor={`quantity-${item.key}`} className="visually-hidden">
+                                    Брой
+                                </label>
+                                <input
+                                    id={`quantity-${item.key}`}
+                                    className="orders-input"
+                                    type="number"
+                                    min="1"
+                                    value={item.quantity}
+                                    onChange={event => setItem(item.key, { quantity: event.target.value })}
+                                />
+
+                                <label htmlFor={`price-${item.key}`} className="visually-hidden">
+                                    Цена
+                                </label>
+                                <input
+                                    id={`price-${item.key}`}
+                                    className="orders-input"
+                                    type="number"
+                                    min="0"
+                                    step="0.01"
+                                    placeholder="0.00"
+                                    value={item.unitPrice}
+                                    onChange={event => setItem(item.key, { unitPrice: event.target.value })}
+                                />
+
+                                <button
+                                    type="button"
+                                    className="order-item-remove"
+                                    aria-label="Премахни продукта"
+                                    disabled={items.length === 1}
+                                    onClick={() =>
+                                        setItems(current => current.filter(x => x.key !== item.key))
+                                    }
+                                >
+                                    ×
+                                </button>
+                            </div>
+
+                            {item.isCustom && (
+                                <div className="order-field">
+                                    <label htmlFor={`custom-${item.key}`}>Какво е поръчано</label>
+                                    <input
+                                        id={`custom-${item.key}`}
+                                        className="orders-input"
+                                        type="text"
+                                        maxLength={150}
+                                        placeholder="напр. Букет в синьо с плюшено зайче"
+                                        value={item.name}
+                                        onChange={event => setItem(item.key, { name: event.target.value })}
+                                    />
+                                </div>
+                            )}
+                        </div>
+                    ))}
+
+                    <button
+                        type="button"
+                        className="orders-text-btn order-add-item"
+                        onClick={() => setItems(current => [...current, emptyItem()])}
+                    >
+                        + Добави продукт
+                    </button>
+                </section>
+
+                <section className="order-form-section">
+                    <h3>Доставка и плащане</h3>
+
+                    <ChoicePills
+                        label="Куриер"
+                        options={COURIER_LABELS}
+                        value={form.courier}
+                        onChange={value => setField('courier', value)}
+                    />
+
+                    {form.courier !== 'PICKUP' && (
+                        <div className="order-field">
+                            <label htmlFor="deliveryAddress">Град и офис или адрес</label>
+                            <input
+                                id="deliveryAddress"
+                                className="orders-input"
+                                type="text"
+                                maxLength={300}
+                                placeholder="напр. София, офис Еконт Лозенец"
+                                value={form.deliveryAddress}
+                                onChange={event => setField('deliveryAddress', event.target.value)}
+                            />
+                        </div>
+                    )}
+
+                    <ChoicePills
+                        label="Плащане"
+                        options={PAYMENT_LABELS}
+                        value={form.paymentMethod}
+                        onChange={value => setField('paymentMethod', value)}
+                    />
+                </section>
+
+                <section className="order-form-section">
+                    <div className="order-form-grid order-form-grid--deadline">
+                        <div className="order-field">
+                            <label htmlFor="deadline">Краен срок</label>
+                            <input
+                                id="deadline"
+                                className="orders-input"
+                                type="date"
+                                value={form.deadline}
+                                onChange={event => setField('deadline', event.target.value)}
+                            />
+                        </div>
+
+                        <div className="order-field">
+                            <label htmlFor="notes">Бележка</label>
+                            <textarea
+                                id="notes"
+                                className="orders-input"
+                                rows={3}
+                                maxLength={2000}
+                                placeholder="Персонализация, цветове, надпис на картичката…"
+                                value={form.notes}
+                                onChange={event => setField('notes', event.target.value)}
+                            />
+                        </div>
+                    </div>
+                </section>
+
+                {isEdit && (
+                    <section className="order-form-section">
+                        <h3>Статус и проследяване</h3>
+
+                        <div className="order-form-grid order-form-grid--2">
+                            <div className="order-field">
+                                <label htmlFor="status">Статус</label>
+                                <select
+                                    id="status"
+                                    className="orders-input"
+                                    value={form.status}
+                                    onChange={event => setField('status', event.target.value)}
+                                >
+                                    {STATUSES.map(status => (
+                                        <option key={status} value={status}>
+                                            {STATUS_LABELS[status]}
+                                        </option>
+                                    ))}
+                                </select>
+                            </div>
+
+                            <div className="order-field">
+                                <label htmlFor="trackingNumber">Номер на товарителница</label>
+                                <input
+                                    id="trackingNumber"
+                                    className="orders-input"
+                                    type="text"
+                                    maxLength={50}
+                                    value={form.trackingNumber}
+                                    onChange={event => setField('trackingNumber', event.target.value)}
+                                />
+                            </div>
+                        </div>
+
+                        <label className="order-check">
+                            <input
+                                type="checkbox"
+                                checked={form.isPaid}
+                                onChange={event => setField('isPaid', event.target.checked)}
+                            />
+                            Платено
+                        </label>
+                    </section>
+                )}
+
+                {error && <p className="orders-message orders-message--error">{error}</p>}
+
+                <div className="order-form-footer">
+                    <div className="order-form-total">
+                        <span>Общо</span>
+                        <strong>{formatMoney(total)}</strong>
+                    </div>
+
+                    <div className="order-form-actions">
+                        <Link to={backLink} className="admin-nav-btn order-cancel">
+                            Отказ
+                        </Link>
+                        <button type="submit" className="orders-btn" disabled={isSaving}>
+                            {isSaving ? 'Запазване...' : 'Запази поръчката'}
+                        </button>
+                    </div>
+                </div>
+            </form>
+        </div>
+    );
+}
diff --git a/client/src/components/admin/orders/order-list/OrderList.css b/client/src/components/admin/orders/order-list/OrderList.css
new file mode 100644
index 0000000..e0f3d71
--- /dev/null
+++ b/client/src/components/admin/orders/order-list/OrderList.css
@@ -0,0 +1,187 @@
+.order-list-top {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  flex-wrap: wrap;
+}
+
+.order-list-top p {
+  margin-top: 4px;
+}
+
+/* Табове по статус */
+.order-tabs {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+.order-tab {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  height: 38px;
+  padding: 0 6px 0 14px;
+  border: 1px solid #8f6a5e;
+  border-radius: 25px;
+  background: #fcf0e8;
+  color: #5c463e;
+  font-size: 0.9rem;
+  cursor: pointer;
+  transition: background 0.15s, color 0.15s;
+}
+
+.order-tab:hover {
+  background: #ebdacf;
+}
+
+.order-tab.active {
+  background: #8f6a5e;
+  color: #fff;
+}
+
+.order-tab-count {
+  min-width: 24px;
+  height: 24px;
+  padding: 0 7px;
+  border-radius: 999px;
+  background: #fff;
+  color: #7a5c52;
+  font-size: 0.78rem;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  font-variant-numeric: tabular-nums;
+}
+
+.order-tab.active .order-tab-count {
+  background: rgba(255, 255, 255, 0.22);
+  color: #fff;
+}
+
+/* Търсене и филтри */
+.order-filters {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 12px;
+}
+
+.order-search {
+  flex: 1 1 320px;
+}
+
+.order-select {
+  width: auto;
+}
+
+/* Таблица */
+.order-table {
+  overflow: hidden;
+}
+
+.order-row {
+  display: grid;
+  grid-template-columns: 90px minmax(0, 1.3fr) minmax(0, 1.5fr) 140px 130px minmax(0, 1fr) 120px;
+  gap: 14px;
+  align-items: center;
+  padding: 14px 20px;
+  border-bottom: 1px solid #f4ebe4;
+  font-size: 0.9rem;
+}
+
+.order-row:last-child {
+  border-bottom: 0;
+}
+
+.order-row:not(.order-row--head):hover {
+  background: #fffaf7;
+}
+
+.order-row--head {
+  padding: 12px 20px;
+  font-size: 0.75rem;
+  letter-spacing: 0.4px;
+  text-transform: uppercase;
+  color: #7a5c52;
+  border-bottom: 1px solid #efe3da;
+}
+
+.order-number {
+  font-weight: 700;
+  color: #8f6a5e;
+  font-variant-numeric: tabular-nums;
+}
+
+.order-number:hover {
+  text-decoration: underline;
+}
+
+.order-cell {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+}
+
+.order-sub {
+  margin-top: 2px;
+  font-size: 0.8rem;
+  color: #7a5c52;
+}
+
+.order-ellipsis {
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.order-amount {
+  text-align: right;
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+}
+
+.order-amount .order-sub {
+  font-weight: 400;
+}
+
+.order-status-select {
+  appearance: none;
+  -webkit-appearance: none;
+  border: 1px solid transparent;
+  padding: 5px 12px;
+  cursor: pointer;
+  transition: border-color 0.15s;
+}
+
+.order-status-select:hover {
+  border-color: currentColor;
+}
+
+.order-empty {
+  padding: 40px 20px;
+  text-align: center;
+  color: #7a5c52;
+}
+
+/* На по-тесен екран всяка поръчка става карта */
+@media (max-width: 900px) {
+  .order-row--head {
+    display: none;
+  }
+
+  .order-row {
+    grid-template-columns: 1fr auto;
+    gap: 6px 12px;
+  }
+
+  .order-row > :nth-child(3),
+  .order-row > :nth-child(6) {
+    grid-column: 1 / -1;
+  }
+
+  .order-amount {
+    text-align: left;
+  }
+}
diff --git a/client/src/components/admin/orders/order-list/OrderList.jsx b/client/src/components/admin/orders/order-list/OrderList.jsx
new file mode 100644
index 0000000..c25a4c1
--- /dev/null
+++ b/client/src/components/admin/orders/order-list/OrderList.jsx
@@ -0,0 +1,282 @@
+import { useEffect, useMemo, useState } from 'react';
+import { Link } from 'react-router';
+import { getOrders, updateOrderStatus } from '../../../../services/orders';
+import {
+    STATUSES,
+    STATUS_LABELS,
+    STATUS_TAB_LABELS,
+    CLOSED_STATUSES,
+    CHANNEL_LABELS,
+    COURIER_LABELS,
+    PAYMENT_LABELS,
+    statusClass,
+    formatOrderNumber,
+    formatMoney,
+    deadlineInfo,
+    daysUntil,
+} from '../../../../utils/orders';
+import '../orders.css';
+import './OrderList.css';
+
+function deliveryText(order) {
+    const courier = COURIER_LABELS[order.courier];
+    return order.trackingNumber ? `${courier} · № ${order.trackingNumber}` : courier;
+}
+
+function paymentText(order) {
+    const method = PAYMENT_LABELS[order.paymentMethod];
+    return order.isPaid ? `${method} · платено` : method;
+}
+
+export default function OrderList() {
+    const [orders, setOrders] = useState([]);
+    const [isLoading, setIsLoading] = useState(true);
+    const [error, setError] = useState('');
+    const [tab, setTab] = useState('active');
+    const [search, setSearch] = useState('');
+    const [courier, setCourier] = useState('');
+    const [sort, setSort] = useState('deadline');
+
+    useEffect(() => {
+        async function loadOrders() {
+            try {
+                setOrders(await getOrders());
+            } catch (err) {
+                setError(err.message);
+            } finally {
+                setIsLoading(false);
+            }
+        }
+
+        loadOrders();
+    }, []);
+
+    const activeOrders = orders.filter(order => !CLOSED_STATUSES.includes(order.status));
+
+    const urgentCount = activeOrders.filter(
+        order => order.deadline && daysUntil(order.deadline) <= 3
+    ).length;
+
+    const tabs = [
+        { value: 'active', label: 'Активни', count: activeOrders.length },
+        { value: 'all', label: 'Всички', count: orders.length },
+        ...STATUSES.map(status => ({
+            value: status,
+            label: STATUS_TAB_LABELS[status],
+            count: orders.filter(order => order.status === status).length,
+        })),
+    ];
+
+    const visibleOrders = useMemo(() => {
+        const query = search.trim().toLowerCase();
+        const digits = query.replace(/\s/g, '');
+
+        const filtered = orders.filter(order => {
+            if (tab === 'active' && CLOSED_STATUSES.includes(order.status)) return false;
+            if (tab !== 'active' && tab !== 'all' && order.status !== tab) return false;
+            if (courier && order.courier !== courier) return false;
+
+            if (query) {
+                const matches =
+                    order.customerName.toLowerCase().includes(query) ||
+                    order.customerPhone.replace(/\s/g, '').includes(digits) ||
+                    formatOrderNumber(order.number).toLowerCase().includes(query);
+
+                if (!matches) return false;
+            }
+
+            return true;
+        });
+
+        return [...filtered].sort((a, b) => {
+            if (sort === 'newest') {
+                return new Date(b.createdAt) - new Date(a.createdAt);
+            }
+
+            // Поръчките без срок отиват най-отдолу.
+            if (!a.deadline) return 1;
+            if (!b.deadline) return -1;
+            return new Date(a.deadline) - new Date(b.deadline);
+        });
+    }, [orders, tab, search, courier, sort]);
+
+    const handleStatusChange = async (order, status) => {
+        const previousStatus = order.status;
+
+        // Сменяме веднага на екрана и връщаме, ако сървърът откаже.
+        setOrders(current =>
+            current.map(item => (item.id === order.id ? { ...item, status } : item))
+        );
+
+        try {
+            await updateOrderStatus(order.id, status);
+        } catch (err) {
+            setError(err.message);
+            setOrders(current =>
+                current.map(item =>
+                    item.id === order.id ? { ...item, status: previousStatus } : item
+                )
+            );
+        }
+    };
+
+    return (
+        <div className="orders-page">
+            <div className="order-list-top">
+                <div>
+                    <h2>Поръчки</h2>
+                    {!isLoading && (
+                        <p className="orders-muted">
+                            {activeOrders.length} активни · {urgentCount} със срок до 3 дни
+                        </p>
+                    )}
+                </div>
+
+                <Link to="/admin/orders/create" className="orders-btn">
+                    + Нова поръчка
+                </Link>
+            </div>
+
+            <div className="order-tabs" role="group" aria-label="Статус">
+                {tabs.map(item => (
+                    <button
+                        type="button"
+                        key={item.value}
+                        className={`order-tab ${tab === item.value ? 'active' : ''}`}
+                        aria-pressed={tab === item.value}
+                        onClick={() => setTab(item.value)}
+                    >
+                        <span>{item.label}</span>
+                        <span className="order-tab-count">{item.count}</span>
+                    </button>
+                ))}
+            </div>
+
+            <div className="order-filters">
+                <label htmlFor="order-search" className="visually-hidden">
+                    Търсене
+                </label>
+                <input
+                    id="order-search"
+                    type="search"
+                    className="orders-input order-search"
+                    placeholder="Търси по име, телефон или номер"
+                    value={search}
+                    onChange={event => setSearch(event.target.value)}
+                />
+
+                <label htmlFor="order-courier" className="orders-muted">Куриер</label>
+                <select
+                    id="order-courier"
+                    className="orders-input order-select"
+                    value={courier}
+                    onChange={event => setCourier(event.target.value)}
+                >
+                    <option value="">Всички</option>
+                    {Object.entries(COURIER_LABELS).map(([value, label]) => (
+                        <option key={value} value={value}>{label}</option>
+                    ))}
+                </select>
+
+                <label htmlFor="order-sort" className="orders-muted">Подреди по</label>
+                <select
+                    id="order-sort"
+                    className="orders-input order-select"
+                    value={sort}
+                    onChange={event => setSort(event.target.value)}
+                >
+                    <option value="deadline">Краен срок</option>
+                    <option value="newest">Най-нови</option>
+                </select>
+            </div>
+
+            {error && <p className="orders-message orders-message--error">{error}</p>}
+
+            <div className="orders-card order-table">
+                <div className="order-row order-row--head" aria-hidden="true">
+                    <span>Номер</span>
+                    <span>Клиент</span>
+                    <span>Продукти</span>
+                    <span>Краен срок</span>
+                    <span>Статус</span>
+                    <span>Доставка</span>
+                    <span className="order-amount">Сума</span>
+                </div>
+
+                {isLoading && <p className="order-empty">Зареждане...</p>}
+
+                {!isLoading && visibleOrders.length === 0 && (
+                    <p className="order-empty">
+                        {orders.length === 0
+                            ? 'Още няма поръчки. Добавете първата с „+ Нова поръчка“.'
+                            : 'Няма поръчки, които отговарят на търсенето.'}
+                    </p>
+                )}
+
+                {visibleOrders.map(order => {
+                    const due = deadlineInfo(order);
+                    const [firstItem, ...otherItems] = order.items;
+
+                    return (
+                        <div className="order-row" key={order.id}>
+                            <Link to={`/admin/orders/${order.id}`} className="order-number">
+                                {formatOrderNumber(order.number)}
+                            </Link>
+
+                            <div className="order-cell">
+                                <span className="order-ellipsis">{order.customerName}</span>
+                                <span className="order-sub">
+                                    {order.customerPhone} · {CHANNEL_LABELS[order.channel]}
+                                </span>
+                            </div>
+
+                            <div className="order-cell">
+                                <span className="order-ellipsis">
+                                    {firstItem?.name}
+                                    {firstItem && firstItem.quantity > 1 && ` ×${firstItem.quantity}`}
+                                </span>
+                                {otherItems.length > 0 && (
+                                    <span className="order-sub order-ellipsis">
+                                        + {otherItems.length} още: {otherItems.map(item => item.name).join(', ')}
+                                    </span>
+                                )}
+                            </div>
+
+                            <div className="order-cell">
+                                <span className={due.className}>{due.text}</span>
+                                {due.date && <span className="order-sub">{due.date}</span>}
+                            </div>
+
+                            <div>
+                                <label htmlFor={`status-${order.id}`} className="visually-hidden">
+                                    Статус на {formatOrderNumber(order.number)}
+                                </label>
+                                <select
+                                    id={`status-${order.id}`}
+                                    className={`order-status-select ${statusClass(order.status)}`}
+                                    value={order.status}
+                                    onChange={event => handleStatusChange(order, event.target.value)}
+                                >
+                                    {STATUSES.map(status => (
+                                        <option key={status} value={status}>
+                                            {STATUS_LABELS[status]}
+                                        </option>
+                                    ))}
+                                </select>
+                            </div>
+
+                            <div className="order-cell">
+                                <span className="order-ellipsis">{deliveryText(order)}</span>
+                            </div>
+
+                            <div className="order-cell order-amount">
+                                <span>{formatMoney(order.total)}</span>
+                                <span className="order-sub">{paymentText(order)}</span>
+                            </div>
+                        </div>
+                    );
+                })}
+            </div>
+        </div>
+    );
+}
diff --git a/client/src/components/admin/orders/orders.css b/client/src/components/admin/orders/orders.css
new file mode 100644
index 0000000..f22ac72
--- /dev/null
+++ b/client/src/components/admin/orders/orders.css
@@ -0,0 +1,208 @@
+/* Общи стилове за страниците с поръчки */
+
+.orders-page {
+  width: 100%;
+  max-width: 1160px;
+  margin: 0 auto;
+  padding: 40px 0 70px;
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+  color: #5c463e;
+}
+
+.orders-page button,
+.orders-page input,
+.orders-page select,
+.orders-page textarea {
+  font-family: "Chocolate Classical Sans", sans-serif;
+}
+
+.orders-page h2 {
+  margin: 0;
+  font-size: 1.9rem;
+  font-weight: 400;
+  color: #8f6a5e;
+}
+
+.orders-back {
+  font-size: 0.875rem;
+  color: #8f6a5e;
+}
+
+.orders-back:hover {
+  text-decoration: underline;
+}
+
+.orders-muted {
+  font-size: 0.85rem;
+  color: #7a5c52;
+}
+
+.orders-card {
+  background: #fff;
+  border-radius: 16px;
+  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
+}
+
+.orders-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  padding: 11px 18px;
+  border: none;
+  border-radius: 10px;
+  background: #8f6a5e;
+  color: #fff;
+  font-size: 0.95rem;
+  cursor: pointer;
+  transition: background 0.25s;
+}
+
+.orders-btn:hover {
+  background: #5c463e;
+  color: #fff;
+}
+
+.orders-btn:disabled {
+  opacity: 0.5;
+  cursor: default;
+  background: #8f6a5e;
+}
+
+.orders-text-btn {
+  background: none;
+  border: none;
+  padding: 0;
+  color: #8f6a5e;
+  font-size: 0.875rem;
+  cursor: pointer;
+}
+
+.orders-text-btn:hover {
+  text-decoration: underline;
+}
+
+.orders-text-btn--danger {
+  color: #a12626;
+}
+
+.orders-input {
+  width: 100%;
+  padding: 10px 12px;
+  border-radius: 10px;
+  border: 1px solid #8f6a5e33;
+  background: #fff;
+  color: #5c463e;
+  font-size: 0.9rem;
+  outline: none;
+  transition: border 0.2s, box-shadow 0.2s;
+}
+
+.orders-input:focus {
+  border-color: #8f6a5e;
+  box-shadow: 0 0 0 3px #8f6a5e22;
+}
+
+.orders-page button:focus-visible,
+.orders-page a:focus-visible,
+.orders-input:focus-visible {
+  outline: 3px solid #8f6a5e;
+  outline-offset: 2px;
+}
+
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
+
+/* Хапчета за избор (канал, куриер, плащане) */
+.orders-pills {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+.orders-pill {
+  padding: 7px 14px;
+  border: 1px solid #8f6a5e;
+  border-radius: 25px;
+  background: #fcf0e8;
+  color: #5c463e;
+  font-size: 0.9rem;
+  cursor: pointer;
+  transition: background 0.15s, color 0.15s;
+}
+
+.orders-pill:hover {
+  background: #ebdacf;
+}
+
+.orders-pill.active {
+  background: #8f6a5e;
+  color: #fff;
+}
+
+/* Етикети за статус */
+.order-status {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 4px 10px;
+  border-radius: 999px;
+  font-size: 0.8rem;
+  white-space: nowrap;
+}
+
+.order-status::before {
+  content: "";
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: currentColor;
+}
+
+.order-status--new { background: #e6eef8; color: #2f5b8a; }
+.order-status--confirmed { background: #efe7f6; color: #5f4380; }
+.order-status--in-progress { background: #fcefd9; color: #7d5210; }
+.order-status--ready { background: #e3f1e6; color: #2e6b40; }
+.order-status--shipped { background: #e3f0f2; color: #265f6a; }
+.order-status--delivered { background: #eeeceb; color: #555; }
+.order-status--cancelled { background: #fbe9e9; color: #963131; }
+
+/* Краен срок */
+.due { color: #5c463e; }
+.due--late { color: #a12626; font-weight: 600; }
+.due--soon { color: #8a5512; font-weight: 600; }
+.due--done,
+.due--none { color: #7a5c52; }
+
+.orders-message {
+  padding: 10px 12px;
+  border-radius: 8px;
+  font-size: 0.9rem;
+  text-align: center;
+}
+
+.orders-message--error {
+  color: #a12626;
+  background: #fdeaea;
+  border: 1px solid #f1bcbc;
+}
+
+@media (max-width: 1200px) {
+  .orders-page {
+    padding: 30px 16px 60px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .orders-page * {
+    transition: none !important;
+  }
+}
