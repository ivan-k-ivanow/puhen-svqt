# Копирай този файл като .env и попълни стойностите.
# .env НЕ се качва в GitHub – там са тайните ключове.

# База данни (Supabase Postgres)
DATABASE_URL=

# Сървър
PORT=3000
JWT_SECRET=
NODE_ENV=development

# Supabase Storage
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_ORDER_BUCKET=order-photos

# Meta Conversions API (Events Manager -> пиксела -> Settings -> Conversions API)
META_PIXEL_ID=1505461411649586
META_CAPI_TOKEN=
# Само за тест – кодът от Test Events. Махни го след теста!
META_TEST_EVENT_CODE=
