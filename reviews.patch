+            </div>
+
+            <div className="reviews-actions">
+                {hasMore && (
+                    <button type="button" className="reviews-more" onClick={() => setShowAll(true)}>
+                        Покажи още отзиви
+                    </button>
+                )}
+                <a
+                    className="reviews-instagram"
+                    href="https://www.instagram.com/puhensvqt/"
+                    target="_blank"
+                    rel="noopener noreferrer"
+                >
