diff --git a/client/src/components/reviews/Reviews.css b/client/src/components/reviews/Reviews.css
new file mode 100644
index 0000000..f6cf7ea
--- /dev/null
+++ b/client/src/components/reviews/Reviews.css
@@ -0,0 +1,257 @@
+.reviews {
+    padding: 100px 16px 0;
+    text-align: center;
+    scroll-margin-top: 90px;
+}
+
+.reviews-header h2 {
+    margin: 0 0 10px;
+    font-family: "Pacifico", cursive;
+    font-weight: 400;
+    font-size: 3rem;
+    line-height: 1.4;
+    color: #8f6a5d;
+}
+
+.reviews-header p {
+    margin: 0 0 48px;
+    font-size: 1.0625rem;
+    color: #7a5c52;
+}
+
+.reviews-grid {
+    max-width: 1100px;
+    margin: 0 auto;
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    gap: 44px 36px;
+    padding: 16px 8px 8px;
+    text-align: left;
+}
+
+/* Полароид снимка */
+.reviews-card {
+    --tilt: 0deg;
+    position: relative;
+    display: flex;
+    flex-direction: column;
+    gap: 14px;
+    padding: 14px 14px 22px;
+    background: #fff;
+    border-radius: 6px;
+    box-shadow: 0 2px 4px rgba(92, 70, 62, 0.06), 0 14px 30px rgba(92, 70, 62, 0.1);
+    transform: rotate(var(--tilt));
+    transition: transform 0.3s, box-shadow 0.3s;
+}
+
+.reviews-card:hover {
+    transform: rotate(0deg) translateY(-6px);
+    box-shadow: 0 4px 8px rgba(92, 70, 62, 0.08), 0 22px 40px rgba(92, 70, 62, 0.14);
+}
+
+.reviews-card:nth-child(3n + 1) {
+    --tilt: -2deg;
+}
+
+.reviews-card:nth-child(3n + 2) {
+    --tilt: 1.2deg;
+}
+
+.reviews-card:nth-child(3n) {
+    --tilt: -0.8deg;
+}
+
+/* Тиксото отгоре */
+.reviews-tape {
+    position: absolute;
+    top: -13px;
+    left: 50%;
+    width: 96px;
+    height: 26px;
+    margin-left: -48px;
+    background: rgba(236, 205, 190, 0.75);
+    border-radius: 2px;
+    transform: rotate(-3deg);
+}
+
+.reviews-card:nth-child(2n) .reviews-tape {
+    background: rgba(214, 226, 206, 0.8);
+    transform: rotate(4deg);
+}
+
+.reviews-photo {
+    display: block;
+    aspect-ratio: 1 / 1;
+    overflow: hidden;
+    border-radius: 3px;
+    background: #f6ece6;
+}
+
+.reviews-photo img {
+    display: block;
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+}
+
+.reviews-photo:focus-visible,
+.reviews-product:focus-visible,
+.reviews-more:focus-visible,
+.reviews-instagram:focus-visible {
+    outline: 3px solid #8f6a5e;
+    outline-offset: 3px;
+}
+
+/* Ако поводът е дълъг, звездите минават на нов ред, вместо поводът да се пречупи */
+.reviews-top {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+    gap: 2px 10px;
+    padding: 0 2px;
+}
+
+.reviews-occasion {
+    margin: 0;
+    font-family: "Pacifico", cursive;
+    font-weight: 400;
+    font-size: 1.375rem;
+    line-height: 1.3;
+    color: #8f6a5d;
+}
+
+.reviews-stars {
+    display: flex;
+    flex-shrink: 0;
+    gap: 2px;
+    color: #c4704f;
+}
+
+.reviews-foot {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+    gap: 6px 8px;
+    margin-top: auto;
+    padding: 10px 2px 0;
+    border-top: 1px dashed #e8d5c8;
+}
+
+.reviews-badge {
+    display: flex;
+    align-items: center;
+    gap: 5px;
+    font-size: 0.8rem;
+    font-weight: 600;
+    color: #4c6a43;
+    white-space: nowrap;
+}
+
+.reviews-product {
+    display: inline-flex;
+    align-items: center;
+    min-height: 32px;
+    font-size: 0.8125rem;
+    font-weight: 600;
+    color: #8f6a5e;
+    text-align: right;
+}
+
+.reviews-product:hover {
+    color: #5c463e;
+}
+
+.reviews-actions {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    gap: 14px;
+    margin-top: 56px;
+}
+
+.reviews-more {
+    height: 50px;
+    padding: 0 26px;
+    border: 1px solid #8f6a5e;
+    border-radius: 999px;
+    background: #fff;
+    color: #8f6a5e;
+    font-family: inherit;
+    font-size: 1rem;
+    font-weight: 600;
+    cursor: pointer;
+    transition: background-color 0.2s, color 0.2s;
+}
+
+.reviews-more:hover {
+    background: #8f6a5e;
+    color: #fff;
+}
+
+.reviews-instagram {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    height: 50px;
+    padding: 0 22px;
+    border-radius: 999px;
+    color: #5c463e;
+    font-size: 1rem;
+    font-weight: 600;
+}
+
+.reviews-instagram:hover {
+    color: #8f6a5e;
+}
+
+@media (max-width: 900px) {
+    .reviews-grid {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+        gap: 36px 24px;
+    }
+}
+
+/* На телефон отзивите се плъзгат хоризонтално */
+@media (max-width: 600px) {
+    .reviews-header h2 {
+        font-size: 2.5rem;
+    }
+
+    .reviews-header p {
+        margin-bottom: 24px;
+        padding: 0 20px;
+    }
+
+    .reviews-grid {
+        display: flex;
+        gap: 22px;
+        margin: 0 -16px;
+        padding: 22px 24px 18px;
+        overflow-x: auto;
+        scroll-snap-type: x mandatory;
+        scrollbar-width: none;
+    }
+
+    .reviews-grid::-webkit-scrollbar {
+        display: none;
+    }
+
+    .reviews-card {
+        flex: 0 0 78%;
+        scroll-snap-align: center;
+    }
+
+    .reviews-actions {
+        margin-top: 30px;
+    }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .reviews-card,
+    .reviews-card:hover {
+        transform: none;
+        transition: none;
+    }
+}
diff --git a/client/src/components/reviews/Reviews.jsx b/client/src/components/reviews/Reviews.jsx
new file mode 100644
index 0000000..8644cf1
--- /dev/null
+++ b/client/src/components/reviews/Reviews.jsx
@@ -0,0 +1,123 @@
+import { useState } from "react";
+import { Link } from "react-router";
+import "./Reviews.css";
+
+// Снимки от клиенти, които са дали съгласие да ги публикуваме (лицата са скрити).
+// Нов отзив: сложи квадратна снимка в client/public/images/reviews/ и добави ред тук.
+// slug е адресът на продукта – страницата му е /products/<slug>.
+const reviews = [
+    {
+        occasion: "Абитуриентски бал",
+        product: "Букет „Абитуриентка“",
+        slug: "buket-abiturientka",
+        image: "/images/reviews/abiturientka.webp",
+    },
+    {
+        occasion: "Първи учебен ден",
+        product: "Букет за Учител",
+        slug: "buket-za-uchitel",
