<!-- Image Modal -->
<div id="image-modal" class="image-modal hidden">
    <span class="close-modal">&times;</span>
    <img id="modal-image" alt="Преглед на продукта">
</div>

<!-- Main -->
<main>

    <!-- Hero -->
           <section class="hero">
            <div class="overlay"></div>
            <!--<h1 class="hero-headline">Пухен Свят</h1>-->
            <p class="hero-subheadline">Персонализирани <br>подаръци, създадени<br>да се помнят.</p>
            <a href="#products" class="btn">Открий своя подарък</a>
        </section>

    <!-- Products -->
    <section class="products" id="products">

        <div class="products-header">

            <h2>
                Нашите продукти
            </h2>

            <p>
                Открийте ръчно изработени подаръци за
                специалните моменти в живота.
            </p>

            <!-- Product filters -->
            <div class="products-filters">

                {{#each categories}}
                <button class="product-filter" data-category="{{this}}">
                    {{this}}
                </button>
                {{/each}}

            </div>

        </div>


        <!-- Product grid -->
        <div class="products-grid">

            {{#each products}}

            <article class="product-card" data-category="{{category}}">

                <div class="product-image-container">

                    <img src="{{imageUrl}}" alt="{{name}}" class="product-image">

                </div>

                <div class="product-info">

                    <h3 class="product-name">
                        {{name}}
                    </h3>

                    <p class="product-description">
                        {{description}}
                    </p>

                    <p class="product-price">
                        {{price}} лв.
                    </p>

                    <a href="/products/{{id}}" class="product-button">
                        Виж продукта
                    </a>

                </div>

            </article>

            {{else}}

            <p class="no-products">
                В момента няма налични продукти.
            </p>

            {{/each}}

        </div>

    </section>


    <!-- FAQ -->
    <section class="faq" id="faqs">

        <div class="faq-header">

            <h2>
                Често задавани въпроси
            </h2>

            <p>
                Всичко, което трябва да знаете за нашите
                ръчно изработени продукти и поръчки.
            </p>

        </div>


        <div class="faq-accordion">

            <div class="faq-item">

                <button class="faq-question">
                    Как мога да поръчам продукт?
                </button>

                <div class="faq-answer">

                    <p>
                        Можете да направите поръчка чрез формата
                        в сайта (в най-долната част на страницата)
                        или чрез лично съобщение в нашите социални
                        мрежи – Facebook, Instagram и TikTok.
                    </p>

                </div>

            </div>


            <div class="faq-item">

                <button class="faq-question">
                    Колко време отнема изработката?
                </button>

                <div class="faq-answer">

                    <p>
                        Минималният срок за изработка е 7 работни
                        дни, в зависимост от натовареността и
                        спецификите на продукта.
                    </p>

                </div>

            </div>


            <div class="faq-item">

                <button class="faq-question">
                    Мога ли да поръчам персонализиран продукт?
                </button>

                <div class="faq-answer">

                    <p>
                        Да, изработваме продукти по индивидуална
                        поръчка според вашите предпочитания –
                        цветове, размери и детайли.
                    </p>

                </div>

            </div>


            <div class="faq-item">

                <button class="faq-question">
                    Как се поддържат продуктите?
                </button>

                <div class="faq-answer">

                    <p>
                        Препоръчваме да се съхраняват на сухо място,
                        далеч от влага и директна слънчева светлина,
                        за да запазят вида си по-дълго.
                    </p>

                </div>

            </div>


            <div class="faq-item">

                <button class="faq-question">
                    Как се извършва доставката?
                </button>

                <div class="faq-answer">

                    <p>
                        Изпращаме поръчките с куриер до адрес или
                        офис, като ще получите повече информация
                        при потвърждение на поръчката.
                    </p>

                </div>

            </div>

        </div>

    </section>

    <script src="/js/faq.js"></script>

</main>