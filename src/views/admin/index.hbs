<div id="manage-products" class="admin-section">

    <h2>Всички Продукти</h2>

    <div id="toast-update" class="toast hidden"></div>

    <div class="admin-filters">

        <input type="text" id="admin-search" placeholder="Търси по име..." />

        <select id="admin-category-filter">
            <option value="">Всички категории</option>
            <option value="birthday">Рожден ден</option>
            <option value="christening">Кръщене</option>
            <option value="wedding">Сватба</option>
            <option value="anniversary">Годишнина</option>
            <option value="teacher">Учител</option>
            <option value="other">Други</option>
        </select>

    </div>


    <ul id="products-list">

        <li class="admin-product">

            <span class="drag-handle">☰</span>

            <img src="/images/product-example.jpg" alt="Примерен продукт" class="admin-product-image"
                style="cursor: zoom-in">

            <div class="admin-product-info">

                <strong>Примерен продукт</strong>

                <p>
                    <b>Категории:</b>
                    Рожден ден
                </p>

                <p>
                    <b>Снимки:</b>
                    1
                </p>

            </div>


            <div class="admin-product-actions">

                <a href="/admin/products/edit" class="edit-product">
                    Редактирай
                </a>

                <button type="button" class="delete-product">
                    Премахни Продукт
                </button>

            </div>

        </li>


        <li class="admin-product">

            <span class="drag-handle">☰</span>

            <img src="/images/product-example.jpg" alt="Втори примерен продукт" class="admin-product-image"
                style="cursor: zoom-in">

            <div class="admin-product-info">

                <strong>Втори примерен продукт</strong>

                <p>
                    <b>Категории:</b>
                    Кръщене
                </p>

                <p>
                    <b>Снимки:</b>
                    2
                </p>

            </div>


            <div class="admin-product-actions">

                <a href="/admin/products/edit" class="edit-product">
                    Редактирай
                </a>

                <button type="button" class="delete-product">
                    Премахни Продукт
                </button>

            </div>

        </li>

    </ul>

</div>