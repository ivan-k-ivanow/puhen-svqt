<section id="add-product" class="admin-section">

    <h2>Добави Продукт</h2>

    <form id="product-form" class="admin-form" action="/admin/products/create" method="POST">
        <input name="name" placeholder="Име на продукт" required />
        <input name="price" type="number" placeholder="Цена" />
        <input type="file" name="image" accept="image/*" id="image-input" style="display: none" />
        <label for="image-input" class="image-upload-btn">+ Добави снимка</label>


            <div class="category-checkboxes">
                {{#each categories}}
                <div class="category-item">
                    <label>
                        <input type="checkbox" name="categoryIds" value="{{id}}" {{#if selected}}checked{{/if}}>
                        <span>{{name}}</span>
                    </label>

                    <button type="button" class="category-delete-btn" data-category-id="{{id}}">
                        ×
                    </button>
                </div>
                {{/each}}
            </div>

        <div class="category-actions">
            <a href="/admin/categories/create" class="create-category-btn"> + Създай категория </a>
            <a href="/admin/categories/delete" class="delete-category-btn"> - Изтрий категория </a>
        </div>

        <textarea name="shortDescription" placeholder="Кратко описание (за каталога)" maxlength="100"></textarea>
        <textarea name="description" placeholder="Описание (за продуктовата страница)"></textarea>
        <button type="submit">
            Добави Продукта
        </button>
        <div id="toast-add" class="toast hidden"></div>
    </form>
</section>