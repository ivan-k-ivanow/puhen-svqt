<script src="/js/admin-products.js" defer></script>

<section id="edit-product" class="admin-section">
    <h2>Редактирай Продукт</h2>

    <form id="product-form" class="admin-form" action="/admin/products/edit/{{product.id}}" method="POST">

        <input name="name" placeholder="Име на продукт" value="{{product.name}}" required />

        <input name="price" type="number" step="0.01" placeholder="Цена" value="{{product.price}}" required />

        <div class="product-images">
            <h3>Снимки на продукта</h3>

            {{#if product.images.length}}
            <div class="image-preview-container">
                {{#each product.images}}
                <div class="preview-wrapper">
                    <img src="{{url}}" alt="{{../product.name}}" class="image-preview">
                    <button type="button" class="preview-remove-btn" data-image-id="{{id}}">×</button>
                </div>
                {{/each}}
            </div>
            {{else}}
            <p>Няма добавени снимки.</p>
            {{/if}}
        </div>

        <input type="file" name="image" accept="image/*" id="image-input" style="display: none" />

        <label for="image-input" class="image-upload-btn">+ Добави снимка</label>

        <div class="category-section">
            <h3>Категории</h3>

            <div class="category-checkboxes">
                {{#each categories}}
                <div class="category-item">
                    <label>
                        <input type="checkbox" name="categoryIds" value="{{id}}" {{#if selected}}checked{{/if}}>
                        <span>{{name}}</span>
                    </label>

                    <button type="button" class="category-delete-btn" data-category-id="{{id}}">
                        ×
                    </button>
                </div>
                {{/each}}
            </div>

            <div class="category-actions">
                <a href="/admin/categories/create" class="create-category-btn">+ Създай категория</a>
            </div>
        </div>

        <textarea name="shortDescription" placeholder="Кратко описание (за каталога)"
            maxlength="100">{{product.shortDescription}}</textarea>

        <textarea name="description"
            placeholder="Описание (за продуктовата страница)">{{product.description}}</textarea>

        <button type="submit">Запази Промените</button>

        <div id="toast-edit" class="toast hidden"></div>

    </form>
</section>