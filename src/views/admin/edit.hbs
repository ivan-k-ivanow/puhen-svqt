<section id="edit-product" class="admin-section">

    <h2>Редактирай Продукт</h2>
    <form id="product-form" class="admin-form">
        <input name="name" placeholder="Име на продукт" required />
        <input name="price" type="number" placeholder="Цена" />
        <input type="file" name="image" accept="image/*" id="image-input" style="display: none" />
        <div class="category-checkboxes">
            <label>
                <input type="checkbox" name="category" value="birthday">
                <span>Рожден ден</span>
            </label>

            <label>
                <input type="checkbox" name="category" value="christening">
                <span>Кръщене</span>
            </label>

            <label>
                <input type="checkbox" name="category" value="wedding">
                <span>Сватба</span>
            </label>

            <label>
                <input type="checkbox" name="category" value="anniversary">
                <span>Годишнина</span>
            </label>

            <label>
                <input type="checkbox" name="category" value="teacher">
                <span>Учител</span>
            </label>

            <label>
                <input type="checkbox" name="category" value="other">
                <span>Други</span>
            </label>

        </div>

        <textarea name="shortDescription" placeholder="Кратко описание (за каталога)" maxlength="100"></textarea>
        <textarea name="description" placeholder="Описание (за продуктовата страница)"></textarea>
        <button type="submit">
            Запази Промените
        </button>
        <div id="toast-edit" class="toast hidden"></div>
    </form>
</section>